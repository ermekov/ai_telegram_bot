TELEGRAM_BOT_TOKEN=YOUR_NEW_TELEGRAM_BOT_TOKEN
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# The n8n workflow used gpt-4.1. You can switch to gpt-4.1-mini to reduce cost.
OPENAI_CHAT_MODEL=gpt-4.1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Local SQLite storage for chat memory and leads.
DATABASE_PATH=data/bot.sqlite3
CONTEXT_WINDOW=20

# Optional Google Sheets integration. If disabled, leads stay in SQLite only.
GOOGLE_SHEETS_ENABLED=True
GOOGLE_SHEETS_CREDENTIALS_FILE=service_account.json
GOOGLE_SHEETS_SPREADSHEET_ID=1s2geGfirfuy2AEKBIy4BNatTP5D8r_WSg8AEjMosnxA
GOOGLE_SHEETS_WORKSHEET=Лист1
